datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  companies    CompanyUser[]
  createdAt    DateTime @default(now())
}

model Company {
  id            String        @id @default(uuid())
  name          String
  vatNumber     String?
  baseCurrency  String        @default("BWP")
  filingMonthly Boolean       @default(true)
  users         CompanyUser[]
  accounts      Account[]
  taxRates      TaxRate[]
  invoices      Invoice[]
  vatReturns    VatReturn[]
  createdAt     DateTime      @default(now())
}

model CompanyUser {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String   @default("admin")
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
}

model Account {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  code      String
  name      String
  type      String
  createdAt DateTime @default(now())
}

model TaxRate {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  code      String
  name      String
  rate      Float
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime @default(now())
}

model Invoice {
  id         String        @id @default(uuid())
  company    Company       @relation(fields: [companyId], references: [id])
  companyId  String
  contact    String?
  invoiceNo  String
  issueDate  DateTime
  dueDate    DateTime?
  status     String        @default("draft")
  subtotal   Float         @default(0)
  taxTotal   Float         @default(0)
  total      Float         @default(0)
  lines      InvoiceLine[]
  createdAt  DateTime      @default(now())
}

model InvoiceLine {
  id         String   @id @default(uuid())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId  String
  description String
  quantity   Float    @default(1)
  unitPrice  Float    @default(0)
  amount     Float    @default(0)
  taxRate    TaxRate? @relation(fields: [taxRateId], references: [id])
  taxRateId  String?
  taxAmount  Float    @default(0)
}

model VatReturn {
  id         String   @id @default(uuid())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String
  periodStart DateTime
  periodEnd   DateTime
  outputTax  Float    @default(0)
  inputTax   Float    @default(0)
  adjustments Float   @default(0)
  netVat     Float    @default(0)
  createdAt  DateTime @default(now())
}
